{
  "schemaVersion": 1,
  "id": "vibrantmod",
  "version": "${version}",
  "name": "Vibrant World",
  "description": "Adds customisable colour vibrancy / saturation boost to Minecraft, inspired by the Vibrant Vanilla resource pack.",
  "authors": ["YourName"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.vibrantmod.VibrantModClient"],
    "modmenu": ["com.vibrantmod.client.VibrantModMenuIntegration"]
  },
  "mixins": ["vibrantmod.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
